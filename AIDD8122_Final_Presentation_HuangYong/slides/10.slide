<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative' }}>
  <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 64, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', paddingLeft: 44, paddingRight: 44 }}>
    <Text style={{ color: '#FFFFFF', fontSize: 26, fontWeight: 'bold' }}>Prospective failure is a level shift, not a ranking signal</Text>
    <Text style={{ color: '#C9D9F2', fontSize: 14, marginLeft: 'auto' }}>04 · Results</Text>
  </Box>
  <Box style={{ position: 'absolute', top: 110, left: 60, width: 700, flexDirection: 'column' }}>
    <Image src="assets/temporal.png" style={{ width: 700, height: 284 }} />
    <Text style={{ fontSize: 15.5, color: '#4A5568', marginTop: 20, lineHeight: 1.5 }}>Train on compounds published up to 2018, test on 2019&ndash;2024. The model under-predicts every new compound by roughly an order of magnitude &mdash; it has simply never seen the quinoline FAPI series.</Text>
  </Box>
  <Box style={{ position: 'absolute', top: 110, left: 800, width: 420, flexDirection: 'column', gap: 18 }}>
    {[
      { v: '+1.18 log', d: 'systematic offset of the raw model on post-2018 compounds' },
      { v: '&minus;0.82 &rarr; &minus;0.15', d: 'R&sup2; after recalibrating one intercept on 25% of the test set' },
      { v: '&minus;0.12', d: 'Spearman correlation &mdash; unchanged by recalibration: ranking information is absent' },
    ].map((k) => (
      <Box key={k.v} style={{ background: '#E8EFF8', padding: '18px 22px', flexDirection: 'column' }}>
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1.1 }}>{k.v}</Text>
        <Text style={{ fontSize: 15, color: '#1A2230', marginTop: 8, lineHeight: 1.45 }}>{k.d}</Text>
      </Box>
    ))}
    <Text style={{ fontSize: 15, color: '#D9534F', fontWeight: 'bold', lineHeight: 1.4 }}>Recalibration restores the level, never the ranking.</Text>
  </Box>
  <Box style={{ position: 'absolute', top: 672, left: 60, width: 1160, flexDirection: 'row' }}>
    <Text style={{ fontSize: 12, color: '#8B97A8' }}>AIDD8122 Final Project &mdash; Trust Before Throughput</Text>
    <Text style={{ fontSize: 12, color: '#8B97A8', marginLeft: 'auto' }}>10 / 15</Text>
  </Box>
</Slide>
